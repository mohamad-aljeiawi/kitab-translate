# --- Python ---
.venv/
.venv-build/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- kitab runtime output ---
# Stage files and rendered books. Regenerated by any run; never committed.
out/
work/
.kitab/

# --- Local configuration and credentials ---
# Engine API keys live in the environment or ~/.config/kitab/config.json.
# Nothing key-shaped belongs in the repository.
config.json
.env
.env.*
!.env.example

# --- Copyrighted source material ---
# Books used for local testing are not redistributable. Keep every real book,
# and everything derived from one, out of git. Only content that is original or
# public domain may live under samples/.
samples/book-sample/
samples/**/*.epub
samples/**/*.pdf
*.epub
*.pdf
!docs/**/*.pdf
