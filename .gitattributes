# Normalise to LF in the repository; check out native on Windows.
* text=auto

*.py    text diff=python
*.md    text
*.toml  text
*.yml   text
*.css   text
*.j2    text
*.json  text

# Binary assets - never touch line endings.
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.png   binary
*.jpg   binary
*.epub  binary
*.pdf   binary
